# Neon PostgreSQL (même base que le web)
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Clerk — instance de développement existante
# Issuer = frontend API du publishable key (ex: https://internal-oyster-8361.clerk.accounts.dev)
CLERK_ISSUER=https://internal-oyster-8361.clerk.accounts.dev
CLERK_JWKS_URL=https://internal-oyster-8361.clerk.accounts.dev/.well-known/jwks.json
# Parties autorisées (origines web/app) — séparées par des virgules
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# CORS pour le web Next.js
CORS_ORIGINS=http://localhost:3000
